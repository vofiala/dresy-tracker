rules_version = '2';

// Public read, admin-only writes.
// Reads are open so anyone can view jerseys/players without signing in.
// Writes require an authenticated user — with only the Email/Password
// provider enabled and a single admin account, that means the admin.
service cloud.firestore {
  match /databases/{database}/documents {

    match /dresy/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /hraci/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
